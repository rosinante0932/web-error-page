---

<BaseLayout {title}>
  <input type="hidden" value={`客户端的custom_ip: ${JSON.stringify(posts)}`} />
  <input type="hidden" value={`客户端的custom_ip: ${posts.custom_ip}`} />
  <input type="hidden" value={`local_ip: ${posts.local_ip}`} />

  <input type="hidden" value={`客户端的ip: ${posts.ip}`} />
  <input type="hidden" value={`服务端的ip: ${posts.clientIp}`} />
  <input type="hidden" value={`从哪里跳过来的: ${posts.referer}`} />
  <input type="hidden" value={`BOSS: ${process.env.BOSS}`} />
  <input type="hidden" value={`客服链接: ${posts.value}`} />
  <input type="hidden" value={`国家: ${posts.country}`} />
  <input type="hidden" value={`城市: ${posts.city}`} />
  <!-- pc -->

  <div
    class="mt-30 xs:hidden sm:hidden md:hidden lg:hidden xl:flex h-[100%] items-center justify-center flex gap-10"
  >
    <!-- <img src={Img} alt={'403图片'} /> -->
    <ForbiddenImage client:only />
    <div class="h-[100%] flex flex-col justify-center max-w-[410px]">
      <h1 class="pb-[24px]">
        <img
          width="115"
          height="46"
          loading="eager"
          decoding="async"
          src={`/assets/svg/logo-${locale === "zh" ? "zh" : locale === "en" ? "en" : "en"}.svg`}
          alt="403 logo"
        />
      </h1>
      <h2 class="text-[#11254E] text-4xl font-600 pb-[10px]">
        {t(locale, "访问受限制")}
      </h2>
      <h3 class="pb-[10px] text-[20px]">
        {t(locale, "您的IP所在地")}：<span class="text-[#2996F5]"
          >{String(posts.country)} {String(posts.city)}
        </span>
      </h3>

      <h3 class="mt-[10px] text-[20px] pb-[30px]">
        <span class="text-[#2996F5] font-600 ">
          {String(posts.ip)}
        </span>
      </h3>

      <!-- <h3 class="mt-[10px]">
        <span class="text-[red]">
          {String(posts.local_ip)}
        </span>
      </h3> -->

      <p class="text-[20px] pr-10 leading-8" set:html={restrictionHtml} />
      <div class="pt-5">
        <a href={posts.value}>
          <button class="btn-primary"> {t(locale, "联系客服")} </button></a
        >
        <RetryButton
          title={t(locale, "尝试重新访问")}
          class={`btn-info ml-4`}
          client:only
        />
      </div>
    </div>
  </div>
  <!-- h5 -->
  <div class="lg:grid xl:hidden">
    <h2 class="text-center text-2xl text-[#011E42] font-semibold">
      {t(locale, "访问受限制")}
    </h2>
    <h3 class="text-center text-[#969696] mt-2">
      {t(locale, "您的IP所在地")}：<span class="text-[#2996F5]"
        >{String(posts.country)} {String(posts.city)}
      </span>
    </h3>
    <h3 class="text-center font-600 text-[#2996F5] mt-2">{String(posts.ip)}</h3>
    <!-- <h3 class="text-center text-[red] mt-2">{String(posts.local_ip)}</h3> -->
    <ForbiddenImage class="h-[235px] m-auto mt-7.5 block" client:only />
    <!-- <Image
      src={import("~/assets/svg/403.svg")}
      alt="403 logo"
    /> -->
    <p
      class="text-xs/5 text-[#011E42] text-center"
      set:html={restrictionHtml}
    />
    <a href={posts.value}>
      <button
        class="test inline-flex items-center justify-center mt-7.5
      h-[44px] w-[100%] gap-[9.69px]
      rounded-[23.25px]
      text-white text-[16px] font-600
      bg-gradient-to-r from-[#339DFF] to-[#1649FF]
      shadow-[0_0_16px_rgba(51,157,255,0.2)]
      transition-all-300 hover:opacity-90 active:scale-98"
        >{t(locale, "联系客服")}
      </button>
    </a>

    <div
      class="inline-block w-[100%]
    p-[.1px] rounded-[23.25px]
    bg-[linear-gradient(90deg,#339DFF_0%,#1649FF_100%)]
    shadow-[0_0_16px_rgba(51,157,255,0.2)] mt-4"
    >
      <!-- 内层：按钮主体 + 实线蓝色描边（inset 1px） -->
      <RetryButton
        title={t(locale, "尝试重新访问")}
        class={`h-[44px] px-6 w-[100%]
      rounded-[23.25px]
      inline-flex items-center justify-center gap-[9.69px]
      bg-white text-[#1649FF] text-[16px] font-600
      shadow-[inset_0_0_0_1px_#1649FF]
      transition-all-300 hover:bg-white/100 active:scale-98`}
        client:only
      />
    </div>
  </div>
</BaseLayout>
