---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ClientOnlyCounter from '@/components/Hello.vue'

const title = 'Astro + Vue + UnoCSS | SEO + Client-only'
const description = 'Astro 输出 SEO HTML，Vue 组件 client-only 仅负责交互。'
---

<BaseLayout title={title} description={description}>
  <main class="mx-auto max-w-3xl p-6">
    <!-- ✅ 这段 HTML 由 Astro 生成：SEO 友好 -->
    <header class="mb-6">
      <h1 class="text-3xl font-bold tracking-tight">SEO 页面（Astro）+ 交互组件（Vue）</h1>
      <p class="mt-2 text-slate-600">
        标题/描述/OG 都在服务端或构建期输出，搜索引擎能直接读到。
      </p>
    </header>

    <!-- ✅ Vue 组件：只在客户端渲染（不参与 SSR） -->
    <ClientOnlyCounter client:only="vue" />

    <!-- ✅ 你也可以用“可见时再加载” -->
    <!-- <ClientOnlyCounter client:visible /> -->
  </main>
</BaseLayout>
