---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/assets/css/initial.css";
import Qrcode from "@/components/Qrcode.vue";

const title = "易换官网-首页";

const referer = Astro.locals.referer ?? "";
const url = new URL(Astro.url);
const siteParam = url.searchParams.get("site") || "";

const keptQuery = siteParam ? `?site=${encodeURIComponent(siteParam)}` : "";

// 站内链接：带 locale，避免中间件 302
const base = `/${Astro.currentLocale}`;
const href = (p: string) => {
  const path = p === "/" ? "" : p;
  return `${base}${path}${keptQuery}`;
};

const downloadUrl = href("/download");

const btnCls =
  "cursor-pointer flex text-[#fff] font-600 rounded-[40px] items-center justify-center py-3 px-8 bg-[linear-gradient(127.31deg,#3feae4_-9.27%,#5383ff_95.74%)]";
const btnClsWithGap = `${btnCls} ml-4`;
---

