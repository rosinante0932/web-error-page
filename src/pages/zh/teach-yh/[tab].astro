---
import { TABS } from "@/data/teach-yh-tabs";
import BaseLayout from "@/layouts/BaseLayout.astro";

// 固定当前页面语言（因为你文件路径就是 /zh/teach-yh/[tab].astro）
const LOCALE = "zh" as const;

// 所有支持的语言（用于 hreflang）
const LOCALES = ["zh", "en", "th", "vi", "ko", "km"] as const;

function stripUrl(u: URL) {
  const next = new URL(u);
  next.search = "";
  next.hash = "";
  return next;
}

/**
 * 根据当前 URL 生成不同语言的同路径 URL
 * 假设路径结构：/{locale}/teach-yh/{tab}
 */
function withLocale(u: URL, locale: string) {
  const next = stripUrl(u);
  const segs = next.pathname.split("/").filter(Boolean);
  if (segs.length > 0) segs[0] = locale;
  next.pathname = "/" + segs.join("/");
  return next.toString();
}

const { tab } = Astro.params;

// SSR：根据 tab 找当前页
const current = TABS.find((t) => t.key === tab);

// SSR：非法 tab 直接 302 到默认 tab（你原来就想这么干）
if (!current) {
  return Astro.redirect(`/${LOCALE}/teach-yh/${TABS[0].key}`, 302);
}

const canonicalUrl = stripUrl(Astro.url);

// 生成图片路径
const images = Array.from(
  { length: current.count },
  (_, i) => `/assets/teach-yh/${current.dir}/${i + 1}.png`,
);

// 常用链接（统一带 /zh）
const basePath = `/${LOCALE}/teach-yh`;
const firstTabHref = `${basePath}/${TABS[0].key}`;
---

<BaseLayout
  title={current.title}
  description="易换APP使用教程，注册/登录/充值/转账/提现/换汇/扫码/生活缴费步骤说明"
>
  <link rel="canonical" href={canonicalUrl.toString()} />

  {
    LOCALES.map((locale) => (
      <link
        rel="alternate"
        hreflang={locale}
        href={withLocale(canonicalUrl, locale)}
      />
    ))
  }

  <link rel="alternate" hreflang="x-default" href={withLocale(canonicalUrl, "en")} />

  {/* ---------------- PC ---------------- */}
  <section class="relative lg:max-w-[1280px] mx-auto xs:hidden sm:hidden md:hidden lg:hidden xl:block block container mx-auto py-10 mt-[70px]">
    <h2 title="易换APP使用教程">
      <img src="/assets/teach-yh/01.svg" alt="易换APP使用教程" class="mx-auto" />
    </h2>

    <nav class="mt-8 flex flex-wrap justify-center gap-4" aria-label="教程导航">
      {
        TABS.map((t) => (
          <a
            title={t.label}
            href={`${basePath}/${t.key}`}
            class={`px-9 text-[18px] py-4 rounded-full shadow font-bold ${
              t.key === current.key
                ? "bg-[linear-gradient(127.31deg,#3feae4_-9.27%,#5383ff_95.74%)] text-white"
                : "bg-white text-[#6b7280]"
            }`}
            aria-current={t.key === current.key ? "page" : undefined}
          >
            {t.label}
          </a>
        ))
      }
    </nav>

    <article class="w-[900px] mx-auto mt-10 bg-white/70 p-8 rounded-[40px] border border-3 border-solid border-[#fff]">
      {images.map((src) => (
        <h3>
          <img class="m-auto w-[60%]" src={src} alt="" loading="lazy" />
        </h3>
      ))}
    </article>
  </section>

  {/* ---------------- H5 ---------------- */}
  <section class="lg:grid xl:hidden bg-[#eef2fe] pb-20 mt-8 overflow-hidden">
    <nav class="flex bg-[#fff] py-3 items-center justify-center gap-4">
      <a
        href={firstTabHref}
        class="text-[#141414] relative after:content-['']
          after:h-1 after:w-18 after:block
          after:absolute -after:bottom-4 after:bg-[#4385ed] after:left-50%
          after:rounded-t-20 after:translate-[-50%]"
      >
        易换APP使用教程
      </a>

      <a href={`/${LOCALE}/teach-dx/download`} class="text-[#969696]">德信教程</a>
      <a href={`/${LOCALE}/teach-mk/deposit`} class="text-[#969696]">MK教程</a>
    </nav>

    <nav data-tabs-nav class="py-6 whitespace-nowrap overflow-x-auto" aria-label="教程导航">
      {
        TABS.map((t) => (
          <a
            data-key={t.key}
            title={t.label}
            href={`${basePath}/${t.key}`}
            class={`px-4 text-sm py-2 rounded-full shadow font-bold mr-2 ${
              t.key === current.key
                ? "bg-[linear-gradient(127.31deg,#3feae4_-9.27%,#5383ff_95.74%)] text-white"
                : "bg-white text-[#6b7280]"
            }`}
            aria-current={t.key === current.key ? "page" : undefined}
          >
            {t.label}
          </a>
        ))
      }
    </nav>

    <article class="mx-auto mt-10 bg-white/70 p-2 rounded-[40px]">
      {images.map((src) => (
        <h3>
          <img class="m-auto w-[90%]" src={src} alt="" loading="lazy" />
        </h3>
      ))}
    </article>
  </section>

  <script is:inline>
    (function () {
      function getTabKeyFromPath() {
        var segs = location.pathname.split("/").filter(Boolean);
        return segs[segs.length - 1];
      }

      function scrollActiveIntoView(nav) {
        var tab = getTabKeyFromPath();
        var active = nav.querySelector('a[data-key="' + CSS.escape(tab) + '"]');
        if (!active) return;

        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            active.scrollIntoView({
              block: "nearest",
              inline: "center",
              behavior: "auto",
            });
          });
        });
      }

      var navs = document.querySelectorAll("[data-tabs-nav]");
      navs.forEach(function (nav) {
        scrollActiveIntoView(nav);

        nav.addEventListener(
          "click",
          function (e) {
            var a = e.target && e.target.closest && e.target.closest("a[data-key]");
            if (!a) return;
            requestAnimationFrame(function () {
              a.scrollIntoView({
                block: "nearest",
                inline: "center",
                behavior: "smooth",
              });
            });
          },
          { passive: true }
        );
      });
    })();
  </script>
</BaseLayout>
