---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/assets/css/initial.css";
import Qrcode from "@/components/Qrcode.vue";
import DeviceDownload from "@/components/DeviceDownload.vue";

const title = "易换官网 - 应用下载";

const referer = Astro.locals.referer ?? "";
const url = new URL(Astro.url);
const siteParam = url.searchParams.get("site") || "";

const keptQuery = siteParam ? `?site=${encodeURIComponent(siteParam)}` : "";

// 站内链接：带 locale，避免中间件 302
const base = `/${Astro.currentLocale}`;
const href = (p: string) => {
  const path = p === "/" ? "" : p;
  return `${base}${path}${keptQuery}`;
};

const downloadLink = href("/download");

// 二维码内容
const qrcodeUrl = downloadLink;

const qrcodeBox =
  "w-[160px] h-[160px] bg-[#fff] flex items-center justify-center mt-[20px]";
const h5Btn =
  "bg-[#4583fe] w-100% py-3 rounded text-[#fff] text-sm";
---

<BaseLayout {title}>
  <div data-referer={referer} style="display:none"></div>

  <!-- pc -->
  <section
    class="container lg:max-w-[1280px] mx-auto mt-[80px] xs:hidden sm:hidden md:hidden lg:hidden xl:block gap-10 min-h-[884px]"
  >
    <div
      class="grid grid-cols-2 gap-20 bg-[length:710px_710px] bg-right bg-no-repeat bg-[url(/assets/download/02.png)]"
    >
      <ul class="flex items-center justify-center flex-col">
        <img src="/assets/yhicon.png" alt="易换" class="w-[124px] h-[124px] mb-[40px]" />

        <h2 class="text-[#147ff2]">
          <span class="text-[#147ff2] text-[36px] font-600">
            全球通兑的货币极速换汇平台
          </span>
        </h2>

        <h3 class="text-[#969696] text-[20px] py-[25px]">
          上百种货币通兑·特有黄金交付·极速到账
        </h3>

        <h4 class="text-[#141414] text-[16px]">请用手机扫描下方二维码下载APP</h4>

        <Qrcode
          client:only
          url={qrcodeUrl}
          size={140}
          className={qrcodeBox}
        />
      </ul>

      <ul class="relative h-[750px] left-[-50px]">
        <img
          src="/assets/download/01.png"
          alt=""
          class="h-[788px] absolute top-0 left-[50%] translate-x-[-50%]"
        />
        <img src="/assets/download/03.png" alt="" class="absolute top-[85px] left-[25px] h-[70px]" />
        <img src="/assets/download/04.png" alt="" class="absolute bottom-[65px] right-[40px] h-[80px]" />
        <img src="/assets/download/05.png" alt="" class="absolute bottom-[380px] right-[-110px] h-[130px]" />
        <img src="/assets/download/06.png" alt="" class="absolute bottom-[150px] right-[-80px] h-[130px]" />
        <img src="/assets/download/07.png" alt="" class="absolute bottom-[280px] left-[-80px] h-[130px]" />
        <img src="/assets/download/08.png" alt="" class="absolute bottom-[50px] left-[-120px] h-[130px]" />
      </ul>
    </div>
  </section>

  <!-- h5 -->
  <div class="lg:grid xl:hidden">
    <div class="bg-content mt-10 bg-center bg-no-repeat">
      <ul class="flex items-center justify-center flex-col">
        <h2 class="text-[#147ff2] text-center">
          <span class="text-[#147ff2] text-8 font-600 leading-12">
            全球通兑的<br />货币极速换汇平台
          </span>
        </h2>

        <h3 class="text-[#969696] text-4 py-[25px]">
          上百种货币通兑·特有黄金交付·极速到账
        </h3>

        <picture class="relative">
          <img
            src="/assets/download/01.png"
            alt="下载展示"
            loading="lazy"
            class="w-[70%] mx-auto relative z-1"
          />
          <img src="/assets/download/02.png" alt="" class="absolute top-50% translate-y-[-50%]" />
          <img src="/assets/download/03.png" alt="" class="absolute top-32 left-0 w-20" />
          <img src="/assets/download/04.png" alt="" class="absolute bottom-32 right-0 w-16" />
          <img src="/assets/download/05.png" alt="" class="absolute top-34 right-10 z-2 h-20" />
          <img src="/assets/download/06.png" alt="" class="absolute top-54 right-0 z-2 h-20" />
          <img src="/assets/download/07.png" alt="" class="absolute bottom-32 left-0 z-2 h-20" />
          <img src="/assets/download/08.png" alt="" class="absolute bottom-10 left-6 z-2 h-20" />
        </picture>

        <a href={downloadLink} class="w-100% px-4">
          <button class={h5Btn}>立即下载</button>
        </a>
      </ul>

      <DeviceDownload client:only="vue" />
    </div>
  </div>
</BaseLayout>
