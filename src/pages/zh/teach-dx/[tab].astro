---
import { TABS } from "@/data/teach-dx-tabs";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Tab = {
  key: string;
  label: string;
  title: string;
  dir: string;
  count: number;
};

const LOCALE = "zh" as const;
const LOCALES = ["zh", "en", "th", "vi", "ko", "km"] as const;

const BASE_ROUTE = `/${LOCALE}/teach-dx`;
const ASSET_BASE = "/assets/teach-dx";

function stripUrl(u: URL) {
  const next = new URL(u);
  next.search = "";
  next.hash = "";
  return next;
}

function withLocale(u: URL, locale: string) {
  const next = stripUrl(u);
  const segs = next.pathname.split("/").filter(Boolean);
  if (segs.length > 0) segs[0] = locale;
  next.pathname = "/" + segs.join("/");
  return next.toString();
}

const hrefOf = (key: string) => `${BASE_ROUTE}/${key}`;

const { tab } = Astro.params;
const current = TABS.find((t) => t.key === tab);

// SSR：非法 tab 直接 302 到默认 tab
if (!current) {
  return Astro.redirect(hrefOf(TABS[0].key), 302);
}

const canonicalUrl = stripUrl(Astro.url);

// 图片列表（绝对路径，避免变成 /zh/assets/...）
const images = Array.from({ length: current.count }, (_, i) => {
  return `${ASSET_BASE}/${current.dir}/${i + 1}.png`;
});
---

<BaseLayout
  title={current.title}
  description="德信使用教程，下载/登录/注册/存款/提现/步骤说明"
>
  <link rel="canonical" href={canonicalUrl.toString()} />

  {
    LOCALES.map((l) => (
      <link rel="alternate" hreflang={l} href={withLocale(canonicalUrl, l)} />
    ))
  }
  <link rel="alternate" hreflang="x-default" href={withLocale(canonicalUrl, "en")} />

  <!-- pc -->
  <section class="hidden xl:block">
    <div class="container mx-auto py-10 mt-[70px]">
      <h2 title="德信使用教程">
        <img
          src="/assets/teach-dx/01.svg"
          alt="德信使用教程"
          class="mx-auto h-[120px]"
        />
      </h2>

      <nav class="mt-8 flex flex-wrap justify-center gap-4" aria-label="教程导航">
        {
          TABS.map((t) => (
            <a
              href={hrefOf(t.key)}
              class={`px-12 text-[18px] py-4 rounded-full shadow font-bold ${
                t.key === current.key
                  ? "bg-[linear-gradient(127.31deg,#3feae4_-9.27%,#5383ff_95.74%)] text-white"
                  : "bg-white text-[#6b7280]"
              }`}
              aria-current={t.key === current.key ? "page" : undefined}
            >
              {t.label}
            </a>
          ))
        }
      </nav>

      <article class="w-[900px] mx-auto mt-10 bg-white/70 p-8 rounded-[40px] border border-3 border-solid border-[#fff]">
        {
          images.map((src, idx) => (
            <figure class="my-6">
              <img
                src={src}
                alt={`${current.label} - 第 ${idx + 1} 步`}
                class="m-auto w-[60%]"
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))
        }
      </article>
    </div>
  </section>

  <!-- h5 -->
  <section class="xl:hidden bg-[#eef2fe] pb-20 mt-8 overflow-hidden">
    <nav class="flex bg-[#fff] py-3 items-center justify-center gap-4">
      <a href="/zh/teach-yh/register" class="text-[#969696]">易换APP使用教程</a>

      <a
        href={hrefOf(TABS[0].key)}
        class="text-[#141414] relative after:content-['']
          after:h-1 after:w-18 after:block
          after:absolute after:-bottom-3 after:bg-[#4385ed]
          after:left-1/2 after:-translate-x-1/2 after:rounded-t-20"
      >
        德信教程
      </a>

      <a href="/zh/teach-mk/deposit" class="text-[#969696]">MK教程</a>
    </nav>

    <nav
      data-tabs-nav
      class="py-6 px-4 whitespace-nowrap overflow-x-auto scroll-smooth"
      aria-label="教程导航"
    >
      {
        TABS.map((t) => (
          <a
            data-key={t.key}
            href={hrefOf(t.key)}
            class={`px-4 text-sm py-2 rounded-full shadow font-bold mr-2 inline-block ${
              t.key === current.key
                ? "bg-[linear-gradient(127.31deg,#3feae4_-9.27%,#5383ff_95.74%)] text-white"
                : "bg-white text-[#6b7280]"
            }`}
            aria-current={t.key === current.key ? "page" : undefined}
          >
            {t.label}
          </a>
        ))
      }
    </nav>

    <article class="mx-auto mt-2 bg-white/70 p-2 rounded-[40px] w-full">
      {
        images.map((src, idx) => (
          <figure class="my-4">
            <img
              class="m-auto w-[90%]"
              src={src}
              alt={`${current.label} - 第 ${idx + 1} 步`}
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))
      }
    </article>
  </section>

  <script is:inline>
    (function () {
      function getTabKeyFromPath() {
        var segs = location.pathname.split("/").filter(Boolean);
        return segs[segs.length - 1];
      }

      function centerActive(nav) {
        if (!nav) return;
        var tab = getTabKeyFromPath();
        var active = nav.querySelector('a[data-key="' + CSS.escape(tab) + '"]');
        if (!active) return;

        // offsetLeft/offsetWidth 计算居中
        var left = active.offsetLeft + active.offsetWidth / 2 - nav.clientWidth / 2;
        nav.scrollTo({ left: Math.max(0, left), behavior: "auto" });
      }

      function run() {
        var nav = document.querySelector("[data-tabs-nav]");
        if (!nav) return;

        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            centerActive(nav);
          });
        });
      }

      // 首次进入 + Astro View Transitions 切页后
      document.addEventListener("DOMContentLoaded", run);
      document.addEventListener("astro:page-load", run);
      document.addEventListener("astro:after-swap", run);
    })();
  </script>
</BaseLayout>
