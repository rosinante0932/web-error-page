  <!-- 移动端手风琴 -->
  <script is:inline>
    const oDls = document.querySelectorAll('dl[data-name="qa"]');
    let openIndex = -1;

    function setIcons(dl, isOpen) {
      const closeIcon = dl.querySelector('img[data-icon="close"]');
      const openIcon = dl.querySelector('img[data-icon="open"]');
      if (closeIcon) closeIcon.classList.toggle("hidden", isOpen);
      if (openIcon) openIcon.classList.toggle("hidden", !isOpen);
    }

    function handleCloseAll() {
      oDls.forEach((dl) => {
        const dd = dl.children[1];
        if (!dd) return;
        dd.classList.add("hidden");
        setIcons(dl, false);
      });
    }

    oDls.forEach((dl, i) => {
      dl.addEventListener("click", function () {
        const dd = dl.children[1];
        if (!dd) return;

        if (openIndex === i) {
          dd.classList.add("hidden");
          setIcons(dl, false);
          openIndex = -1;
          return;
        }

        handleCloseAll();
        dd.classList.remove("hidden");
        setIcons(dl, true);
        openIndex = i;
      });
    });

  </script>
