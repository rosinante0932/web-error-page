---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/assets/css/initial.css";

const title = "易换官网-易换常见问题";

const faqs = [
  {
    q: "如何成为易换注册客户?",
    a: "申请成为易换客户，您可以下载易换APP，客户注册成功后方可尽享易换为您提供的优惠的汇率、快捷的汇款、低廉的费用和优质的换汇服务。",
  },
  {
    q: "如何与易换进行外汇交易?",
    a: "成功注册易换客户后，您可以通过易换APP进行外汇交易，您也可以通过易换客服或易换APP进行交易｡易换只与注册客户本人联系并提供服务，不接受任何形式的第三方授权和代理。",
  },
  {
    q: "为什么选择易换的换汇服务?",
    a: "易换与大型银行和金融机构有着广泛的业务联系并有选择性的进行交易，在业界一直保持较高的交易额和极高的信誉度，从源头来获取更优惠批发汇率。易换不收取任何交易手续费，并在管理和交易各个环节立志节约换汇成本，从而将实惠延伸至客户端。因此我们可以为客户提供诚信、专业、品质、高效的货币兑换和全球汇款一站式服务｡",
  },
  {
    q: "已完成的外汇兑换合约是否可以取消？",
    a: "当客户接受我们的兑换汇率并确认成交后，易换便在国际外汇市场同步完成后台交易，客户不得撤消或更改已成交的交易合约｡无法结算的交易合约将由一个相反的合约来对冲，并由客户承担相应损失｡",
  },
  {
    q: "未及时收到易换支付的款项应该怎么办?",
    a: "如果您的收款方没有及时收到易换支付的款项，请凭汇款凭证尽快联系我们，易换将以最快的速度查明款项未到原因并解决问题｡",
  },
  {
    q: "商业移民换汇解决方案",
    a: "如客户选择了易换的离岸CNY和多地多币种全球换汇服务，在规定时间内完成移民国资产集中重组的目的。在此过程中易换不仅为客户的转款节约大量换汇成本、简化转款手续，洞悉外汇市场波动，避免了客户通过其它途径转款存在的沟通不畅等情况，助力客户顺利通过最终移民审批并且全家愉快的定居海外｡",
  },
  {
    q: "企业贸易换汇解决方案",
    a: "长期从事国际贸易的客户在选择易换进行多种货币结算后，在易换专业团队的助力下有效大幅减少了因经验不足而导致的汇款延迟到账甚至无法入账退款的问题｡大大降低中转银行的扣费支出，更实现了固有资金的高速运转，缩短贸易周期。",
  },
  {
    q: "出国旅游换汇解决方案",
    a: "无论您要出国旅游、留学或是商务旅行，需要购买一定量的目标国家的货币，还是您出国归来携带的外币现金。易换将竭诚为您提供安全快捷的外币兑换服务，最好的兑换汇率、无佣金手续费，更有多种银行不能兑换的货币可供选择｡客户避免了在旅途中换汇的烦恼和在机场、景点等地汇率差、费用高的问题，令旅途更轻松完美｡",
  },
  {
    q: "海外华人换汇解决方案",
    a: "已经移民海外或久居海外的同胞们，都会与家人、亲戚、朋友们保持一定的联系，并且有着不同程度的经济来往｡易换提供的各国汇款服务多年来以高汇率、高效率、低费用、准确无误的方式汇入客户指定账户，为客户在家人、亲戚、朋友们解决了无数燃眉之急，传递了无数的爱心亲情｡移民海外的您都会面对的一件大事就是买房置业，无论是第一次买房自住，还是再次购买升级自住房，又或是自住以外的投资房等，都需要易换的协助对资金进行合理安排｡",
  },
] as const;

const pcOnly = "xs:hidden sm:hidden md:hidden lg:hidden xl:block";
const pcFlexOnly = "xs:hidden sm:hidden md:hidden lg:hidden xl:flex";
const h5Only = "lg:grid xl:hidden";

const pcCard =
  "p-[30px] rounded-[30px] border border-3 shadow-[0_16px_24px_0_rgba(43,142,203,0.078)] border-solid border-[#fff] bg-no-repeat bg-[#f7f9fb] bg-right bg-[url(/assets/service/001.svg)] hover:bg-[rgba(234,251,255,.4)]";

const h5Card =
  "px-4 py-6 pr-0 rounded-6 bg-[#f8f9fe] border border-3 shadow-[0_16px_24px_0_rgba(43,142,203,0.078)] border-solid border-[#fff] hover:bg-[rgba(234,251,255,.4)]";
---

<BaseLayout {title}>
  <!-- pc banner（记得加 relative，否则 absolute 图会乱飞） -->
  <section
    class={`container relative lg:max-w-[1280px] mx-auto mt-[20px] ${pcFlexOnly} items-center justify-between gap-10 min-h-[350px]`}
  >
    <h2 title="易换常见问题">
      <img src="/assets/qa/01.svg" class="ml-[-25px]" alt="易换常见问题" />
    </h2>
    <img
      src="/assets/qa/02.png"
      alt=""
      class="max-w-none absolute z-0 w-[792px] -top-10 -right-50"
      decoding="async"
    />
  </section>

  <!-- pc 内容 -->
  <section
    class={`container pb-[200px] relative z-1 lg:max-w-[1280px] mx-auto ${pcOnly} min-h-[300px]`}
  >
    {faqs.map((item, idx) => (
      <dl class={`${pcCard} ${idx ? "mt-[20px]" : ""}`} key={item.q}>
        <dt>
          <h3 class="flex items-center" title={item.q}>
            <span
              class="text-[28px] w-[48px] h-[48px] flex items-center justify-center rounded-[10px]
              bg-[#e5f2fc] text-[#66b2f2] font-600"
            >
              {idx + 1}
            </span>
            <span class="ml-[30px] text-[28px] font-400 text-[#11254e]">
              {item.q}
            </span>
          </h3>
        </dt>
        <dd class="mt-[14px]">
          <span class="text-[16px] text-[#7281a2] leading-7">{item.a}</span>
        </dd>
      </dl>
    ))}
  </section>

  <!-- h5 -->
  <div class={`${h5Only} bg-[#eef2fe]`}>
    <section class="mt-10 relative z-1 px-4">
      <h2>
        <img class="mx-auto h-20" src="/assets/qa/h5/01.svg" alt="易换常见问题" />
      </h2>
    </section>

    <section class="-translate-y-36 relative z-0 h-43">
      <img src="/assets/qa/h5/02.svg" alt="" class={'mx-auto'}/>
    </section>

    <section class="pt-10 mx-2 relative z-0 pb-20" data-qa-root>
      {faqs.map((item, idx) => (
        <dl
          class={`${h5Card} ${idx ? "mt-4" : ""}`}
          key={item.q}
          data-qa-item
          data-open="0"
        >
          <dt>
            <h3 class="flex items-center" title={item.q}>
              <span
                class="text-lg py-1 px-3 flex items-center justify-center rounded
                bg-[#e5f2fc] text-[#66b2f2] font-600"
              >
                {idx + 1}
              </span>

              <div class="flex justify-between w-[100%] pr-4">
                <span class="ml-2 text-base font-400 text-[#11254e]">
                  {item.q}
                </span>

                <img
                  src="/assets/qa/h5/03.svg"
                  alt="关闭"
                  class="w-6"
                  data-icon="close"
                />
                <img
                  src="/assets/qa/h5/04.svg"
                  alt="开启"
                  class="w-6 hidden"
                  data-icon="open"
                />
              </div>
            </h3>
          </dt>

          <dd class="mt-4 hidden">
            <span class="text-sm text-[#7281a2] leading-7">{item.a}</span>
          </dd>
        </dl>
      ))}
    </section>
  </div>

  <script is:inline>
    (function () {
      const root = document.querySelector("[data-qa-root]");
      if (!root) return;

      function setIcons(dl, isOpen) {
        const closeIcon = dl.querySelector('img[data-icon="close"]');
        const openIcon = dl.querySelector('img[data-icon="open"]');
        if (closeIcon) closeIcon.classList.toggle("hidden", isOpen);
        if (openIcon) openIcon.classList.toggle("hidden", !isOpen);
      }

      function closeAll(except) {
        root.querySelectorAll("[data-qa-item]").forEach((dl) => {
          if (except && dl === except) return;
          const dd = dl.querySelector("dd");
          if (dd) dd.classList.add("hidden");
          dl.dataset.open = "0";
          setIcons(dl, false);
        });
      }

      root.addEventListener("click", (e) => {
        const dl = e.target.closest("[data-qa-item]");
        if (!dl) return;

        const dd = dl.querySelector("dd");
        if (!dd) return;

        const isOpen = dl.dataset.open === "1";
        if (isOpen) {
          dd.classList.add("hidden");
          dl.dataset.open = "0";
          setIcons(dl, false);
        } else {
          closeAll(dl);
          dd.classList.remove("hidden");
          dl.dataset.open = "1";
          setIcons(dl, true);
        }
      });
    })();
  </script>
</BaseLayout>
