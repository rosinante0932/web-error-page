---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/assets/css/initial.css";

const title = "易换官网-易换业务范围";

const referer = Astro.locals.referer ?? "";

const pcOnly = "xs:hidden sm:hidden md:hidden lg:hidden xl:block";
const pcFlexOnly = "xs:hidden sm:hidden md:hidden lg:hidden xl:flex";
const h5Only = "lg:grid xl:hidden";

const pcCardBase =
  "p-[30px] px-[40px] rounded-[40px] border border-3 border-solid border-[#fff] bg-no-repeat bg-[#f7f9fb] bg-right";
const pcTitleWrap = "relative pl-[10px]";
const pcTitleText = "text-[28px] font-600 text-[#11254e]";
const pcDescText = "text-[16px] text-[#7281a2] leading-7";

const h5CardBase =
  "p-6 rounded-[20px] border border-3 border-solid border-[#fff] bg-[rgba(255,255,255,0.7)] shadow-[0_1.231vw_1.846vw_0_rgba(49,76,154,0.05)]";
const h5TitleText = "text-5 font-600 text-[#11254e] relative z-1";
const h5DescText = "text-sm text-[#7281a2] leading-8";

// 数据
type ServiceItem = {
  key: string;
  title: string;
  pcBg: string;
  desc: string;
  pcTitle?: string;
  pcDescTitle?: string;
};

const services: ServiceItem[] = [
  {
    key: "remit",
    title: "汇款服务",
    pcBg: "/assets/service/001.svg",
    desc: "提供国际汇款服务，允许用户从全球各地向其他国家或地区进行资金转移。个人可以使用跨国汇款服务来向其他国家的亲友或家庭成员发送资金，例如用于赡养费用、教育支持或其他支出。",
  },
  {
    key: "rate",
    title: "汇率实时查询",
    pcBg: "/assets/service/002.svg",
    desc: "提供全球各种货币的实时汇率查询服务，方便用户对于汇率的观察和把握。",
  },
  {
    key: "fx",
    title: "外汇交易",
    pcBg: "/assets/service/003.svg",
    desc: "提供全球范围内的外汇买卖服务，包括现汇交易、远期交易和即期点价等业务。",
  },
  {
    key: "foreign-worker",
    title: "外籍工作者汇款",
    pcBg: "/assets/service/004.svg",
    desc: "外籍工作者可以利用这种服务将赚取的资金汇回自己的家乡或家人所在的国家。",
  },
  {
    key: "cross-pay",
    title: "跨境支付",
    pcBg: "/assets/service/005.svg",
    desc: "为客户提供支持海外在线支付、商务支付等服务，以简化跨境资金支付流程。企业可以使用跨国汇款服务来支付供应商、合作伙伴或其他相关业务支出，用于国际贸易和跨境业务。",
  },
  {
    key: "student",
    title: "留学生资金支持",
    pcBg: "/assets/service/006.svg",
    desc: "留学生可以通过这种服务从家乡接收资金，或者向海外支付学费和生活费用。",
  },
  {
    key: "exchange",
    title: "货币兑换",
    pcBg: "/assets/service/007.svg",
    desc: "提供现金或电子货币的换取服务，包括现金兑换、外币储蓄账户等。",
  },
  {
    key: "cash-gold",
    title: "全球送现金/送黄金业务",
    pcBg: "/assets/service/008.svg",
    desc: "服务多个国家送现金业务，当天预约，次日送达。",
  },
  {
    key: "crypto",
    title: "虚拟货币服务",
    pcBg: "/assets/service/009.svg",
    desc: "此项服务通常关联到跨国交易、汇款等业务，用以支持加密货币的交易和转账服务。",
  },
  {
    key: "custom",
    title: "个性化业务",
    pcBg: "/assets/service/0010.svg",
    desc: "提供更为个性化的服务，根据客户需求，设定特定的兑换方式和金额，可提供上门代收取款业务。",
  },
];

const servicesH5 = services.slice(0, 9);

const toPcHtml = (s: string) =>
  s
    .replace(/。/g, "。<br />")
    .replace(/<br \/>\s*<br \/>/g, "<br />")
    .trim();
---

<BaseLayout {title}>
  <div data-referer={referer} style="display:none"></div>

  <!-- PC Banner（加 relative，避免 absolute 图脱离） -->
  <section
    class={`container relative lg:max-w-[1280px] mx-auto mt-[70px] ${pcFlexOnly} items-center justify-between gap-10 min-h-[350px]`}
  >
    <h2 title="易换业务范围">
      <img src="/assets/service/01.svg" class="ml-[-25px]" alt="易换业务范围" />
    </h2>

    <img
      src="/assets/service/02.png"
      alt=""
      class="max-w-none absolute z-0 w-[792px] -top-20 right-0"
    />
  </section>

  <!-- PC 卡片列表 -->
  <section
    class={`container relative z-1 lg:max-w-[1280px] mx-auto ${pcOnly} gap-10 min-h-[308px] pb-[200px]`}
  >
    <div class="grid grid-cols-2 gap-6">
      {
        services.map((item) => (
          <dl class={`${pcCardBase} bg-[url(${item.pcBg})]`} key={item.key}>
            <dt>
              <h3 title={item.title} class={pcTitleWrap}>
                <span class={pcTitleText}>{item.title}</span>
                <img
                  src="/assets/service/03.svg"
                  class="absolute top-[10px] left-[2px]"
                  alt={item.title}
                />
              </h3>
            </dt>

            <dd class="mt-[14px]">
              <h4 title={item.desc}>
                <span class={pcDescText} set:html={toPcHtml(item.desc)} />
              </h4>
            </dd>
          </dl>
        ))
      }
    </div>
  </section>

  <!-- H5 -->
  <div class={`${h5Only} bg-[#eef2fe]`}>
    <section class="mt-10 relative z-1">
      <h2>
        <img
          class="mx-auto h-20"
          src="/assets/service/m/01.svg"
          alt="易换服务"
        />
      </h2>
    </section>

    <section class="-translate-y-35 relative z-0 h-43">
      <img src="/assets/service/m/02.svg" alt="" class="mx-auto" />
    </section>

    <section class="pt-10 mx-2 relative z-0 pb-20">
      {
        servicesH5.map((item) => (
          <dl class={`${h5CardBase} mt-4 first:mt-0`} key={item.key}>
            <dt>
              <h3 class="py-2 relative pl-2">
                ``
                <span class={h5TitleText}>{item.title}</span>
                <img
                  src="/assets/service/03.svg"
                  class="absolute top-1.5 left-0"
                  alt={item.title}
                />
              </h3>
            </dt>
            <dd>
              <h4 class={h5DescText}>{item.desc}</h4>
            </dd>
          </dl>
        ))
      }
    </section>
  </div>
</BaseLayout>
