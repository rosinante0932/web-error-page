---
import BaseLayout from "@/layouts/BaseLayout.astro";
import API from "@/api/index.js";
import "@/assets/css/initial.css";

const title = "易换官网-联系我们";
const referer = Astro.locals.referer;

let posts = {
  ip: "192.168.0.1",
  referer,
  country: "",
  city: "",
  value: "",
  clientIp: Astro.locals.clientIP,
  custom_ip: Astro.locals.clientIP,
};

console.log(Astro.locals.clientIP, "客户端ip");

console.log(process.env.DOCKER_PROXY_NET, "==================DOCKER_PROXY_NET");

try {
  const res = await API.getKvConfig(
    {
      k: "official.contact.us.telegram.text",
    },
    {
      headers: {
        "x-forwarded-for": Astro.locals.local_ip,
        "x-real-ip": Astro.locals.local_ip,
      },
    },
  );

  console.log(" Astro.locals.local_ip", Astro.locals.local_ip);

  posts = {
    ...posts,
    ...res.data,
  };

  console.log(res.data, "正确获取归属地的 --- contactus");

  console.log(res, "res--- contactus");
} catch (error) {
  console.log(error, "--报错获取归属地的--- contactus");
}
---

<BaseLayout {title}>
  <!-- pc -->
  <input type="hidden" value={JSON.stringify(posts)} />
  <section
    class="lg:max-w-[1280px] mx-auto mt-[70px] xs:hidden sm:hidden md:hidden lg:hidden xl:flex flex items-center justify-between gap-10 min-h-[300px]"
  >
    <div>
      <h2 class="text-[28px]" title="联系我们">
        <img
          src="/assets/contactus/01.svg"
          alt="联系我们"
          class="w-[254px] h-[90px] ml-[-25px]"
        />
      </h2>
      <h3 class="text-[20px] text-[#7281a2] font-400 leading-10">
