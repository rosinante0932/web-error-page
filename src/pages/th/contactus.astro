---
import BaseLayout from "@/layouts/BaseLayout.astro";
import API from "@/api/index.js";
import "@/assets/css/initial.css";

const title = "易换官网-联系我们";

const referer = Astro.locals.referer ?? "";
const url = new URL(Astro.url);
const siteParam = url.searchParams.get("site") || "";

const safeClientIp = Astro.locals.clientIP ?? "";
const safeLocalIp = Astro.locals.local_ip ?? "";

const cacheKey = "__kv_cache__";
const locals = Astro.locals as any;
locals[cacheKey] ||= new Map<string, Promise<any>>();

function cachedKvGet(k: string) {
  const m: Map<string, Promise<any>> = locals[cacheKey];
  if (!m.has(k)) {
    m.set(
      k,
      API.getKvConfig(
        { k },
        {
          headers: {
            "x-forwarded-for": safeLocalIp,
            "x-real-ip": safeLocalIp,
          },
        },
      ),
    );
  }
  return m.get(k)!;
}

const KV_KEYS = {
  officialTg: "official.contact.us.telegram.text",
} as const;

const DEFAULT_LINKS = {
  officialTg: "https://t.me/yihuanqz",
  cashTg: "https://t.me/yihuansongxian",
  guideTg: "https://t.me/YIHUANAPPVIP",
} as const;

let officialTg: any = DEFAULT_LINKS.officialTg;

try {
  const res = await cachedKvGet(KV_KEYS.officialTg);
  const v = (res?.data?.value ?? res?.data?.data?.value ?? res?.data?.data ?? res?.data?.value) as
    | string
    | undefined;

  if (typeof v === "string" && v.trim()) {
    officialTg = v.trim();
  }
} catch {
  // 兜底：不阻塞渲染
  officialTg = DEFAULT_LINKS.officialTg;
}

const contacts = [
  {
    key: "official",
    title: "易换官方TG",
    icon: "/assets/contactus/03.svg",
    url: officialTg,
  },
  {
    key: "cash",
    title: "易换送现TG",
    icon: "/assets/contactus/04.svg",
    url: DEFAULT_LINKS.cashTg,
  },
  {
    key: "guide",
    title: "APP操作指南TG",
    icon: "/assets/contactus/05.svg",
    url: DEFAULT_LINKS.guideTg,
  },
] as const;

const pcOnly = "xs:hidden sm:hidden md:hidden lg:hidden xl:block";
const pcFlexOnly = "xs:hidden sm:hidden md:hidden lg:hidden xl:flex";
const h5Only = "lg:grid xl:hidden";

// 统一卡片样式
const pcCard =
  "p-[50px] rounded-[40px] flex flex-col items-center justify-center border border-3 border-solid border-[#fff] bg-[rgba(255,255,255,0.7)]";
const h5Card =
  "p-6 rounded-4 border border-3 border-solid border-[#fff] bg-[rgba(255,255,255,0.7)] shadow-[0_1.231vw_1.846vw_0_rgba(49,76,154,0.05)]";

const normalizeUrl = (s: string) => (s || "").trim();
---

<BaseLayout {title}>
  <div
    style="display:none"
    data-referer={referer}
    data-client-ip={safeClientIp}
    data-site={siteParam}
  />

  <!-- pc banner（补 relative，避免 absolute 图乱定位） -->
  <section
    class={`container relative lg:max-w-[1280px] mx-auto mt-[70px] ${pcFlexOnly} items-center justify-between gap-10 min-h-[300px]`}
  >
    <div class="relative z-1">
      <h2 class="text-[28px]" title="联系我们">
        <img
          src="/assets/contactus/01.svg"
          alt="联系我们"
          class="w-[254px] h-[90px] ml-[-25px]"
        />
      </h2>

      <h3 class="text-[20px] text-[#7281a2] font-400 leading-10">
        易换是从事于各国送现、多国币种兑换以及国际汇款业务的金融服务公司，<br />
        换汇币种覆盖非洲、欧洲东部和西欧等全球多个国家，可以操作美国USD、<br />
        香港HKD、新西兰NZD、欧洲EUR、新加坡SGD、英国GBP等主流货币 <br />
        的外汇交易
      </h3>
    </div>

    <img
      src="/assets/contactus/02.png"
      alt=""
      class="max-w-none absolute z-0 w-[550px] -top-[10px] right-[10px]"
      loading="eager"
      decoding="async"
    />
  </section>

  <!-- pc cards -->
  <section
    class={`container lg:max-w-[1280px] mx-auto pt-[140px] pb-[200px] ${pcOnly} gap-10 min-h-[308px]`}
  >
    <div class="grid grid-cols-3 gap-5">
      {contacts.map((c) => (
        <ul class={pcCard} key={c.key}>
          <h3 class="text-[28px] flex items-center justify-center" title={c.title}>
            <img src={c.icon} alt={c.title} />
          </h3>

          <h4 class="flex items-center justify-center pt-[20px]" title={c.url}>
            <a
              href={normalizeUrl(c.url)}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[20px] text-[#11254e] font-400 hover:text-[#2996f5]"
            >
              {normalizeUrl(c.url)}
            </a>
          </h4>
        </ul>
      ))}
    </div>
  </section>

  <!-- h5 -->
  <div class={`${h5Only} bg-[#eef2fe]`}>
    <section class="mt-10 relative z-1 px-4">
      <h2>
        <img class="mx-auto h-20" src="/assets/contactus/01.svg" alt="联系我们" />
      </h2>

      <h3 class="leading-8">
        <span class="text-[#7281a2] text-xs">
          易换是从事于各国送现、多国币种兑换以及国际汇款业务的金融服务公司，
          换汇币种覆盖非洲、欧洲东部和西欧等全球多个国家，可以操作美国USD、
          香港HKD、新西兰NZD、欧洲EUR、新加坡SGD、英国GBP等主流货币的外汇交易
        </span>
      </h3>
    </section>

    <section class="translate-y-2 relative z-0 h-43">
      <img src="/assets/contactus/02.png" alt="" />
    </section>

    <section class="pt-10 mx-2 relative z-0 pb-20">
      {contacts.map((c) => (
        <dl class={`${h5Card} mt-6 first:mt-0`} key={c.key}>
          <dt>
            <h3 class="flex items-center justify-center" title={c.title}>
              <img src={c.icon} alt={c.title} />
            </h3>
          </dt>
          <dd>
            <h4 class="flex items-center justify-center pt-2" title={c.url}>
              <a
                class="text-base text-[#11254e] font-400"
                href={normalizeUrl(c.url)}
                target="_blank"
                rel="noopener noreferrer"
              >
                {normalizeUrl(c.url)}{c.key === "official" ? "(接口)" : ""}
              </a>
            </h4>
          </dd>
        </dl>
      ))}
    </section>
  </div>
</BaseLayout>
