---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/assets/css/initial.css";

const title = "易换官网-关于我们";

const referer = Astro.locals.referer ?? "";

const pcOnly = "xs:hidden sm:hidden md:hidden lg:hidden xl:block";
const h5Only = "lg:grid xl:hidden";

const gradientLine =
  "after:content-[''] after:block after:w-[100%] after:h-[4px] after:rounded-[43px] after:absolute after:bottom-0 after:bg-[linear-gradient(90deg,_#3feae4_-13.67%,_#5383ff)]";
---

<BaseLayout {title}>
  <div data-referer={referer} style="display:none"></div>

  <!-- PC 顶部 Banner -->
  <section
    class={`container relative lg:max-w-[1280px] mx-auto mt-[70px] ${pcOnly} xl:flex items-center justify-between gap-10 min-h-[400px]`}
  >
    <h2>
      <img src="/assets/aboutus/01.svg" alt="" class="w-[570px] h-[160px] ml-[-25px]" />
    </h2>
    <img
      src="/assets/aboutus/02.png"
      alt=""
      class="max-w-none absolute z-0 w-[792px] top-[-84px] right-[-186px]"
    />
  </section>

  <!-- PC 简介 -->
  <section
    class={`container relative z-1 lg:max-w-[1280px] mx-auto ${pcOnly} xl:flex items-center justify-between min-h-[300px]`}
  >
    <img src="/assets/aboutus/03.svg" alt="新一代互联网银行" />
    <div>
      <h2 class="py-[32px]">
        <span class="text-[40px] font-600 text-[#11254e]">新一代互联网银行</span>
      </h2>
      <h3>
        <span class="text-[#7281a2] text-[16px] leading-10">
          易换立足亚洲，享誉全球，从2018年成立起，秉承诚信经营为宗旨，<br />
          以安全公正的服务为核心，持续扩展国际化路线，提供覆盖全球币种<br />
          兑换服务，丰富多样的交易形式，持有最强竞争力的汇率，超低的手<br />
          续费回馈给我们广大客户，我们以诚信、专业、高效、稳定的服务经<br />
          营理念，致力于给全球客户最优质的换汇体验。
        </span>
      </h3>
    </div>
  </section>

  <!-- PC 三块能力 -->
  <section
    class={`container lg:max-w-[1280px] mx-auto mt-[70px] ${pcOnly} gap-8 min-h-[300px]`}
  >
    <div class="grid grid-cols-3 gap-20 place-items-start">
      <ul class={`h-[280px] relative ${gradientLine}`}>
        <p class="flex items-center py-[20px] mb-[20px] justify-center relative">
          <img
            src="/assets/aboutus/04.svg"
            alt="覆盖全球多个国家"
            class="w-[64px] h-[64px] absolute left-0"
          />
          <strong class="text-[24px]">覆盖全球多个国家</strong>
        </p>
        <p>
          <strong class="text-[16px] leading-7 text-[#7281a2] font-400">
            支持USDT、菲律宾PHP 、美国USD、香港HKD、迪拜AED、欧洲EUR、台湾TWD、泰国THB、越南VND等等，
            只要客户有换汇需求，易换都能给您服务到位，并不设最高和最低限额。
            所有客户的交易都可以享受我们最优质的服务。
          </strong>
        </p>
      </ul>

      <ul class={`h-[280px] relative ${gradientLine}`}>
        <p class="flex items-center py-[20px] mb-[20px] justify-center relative">
          <img
            src="/assets/aboutus/05.svg"
            alt="支持定制需求服务"
            class="w-[64px] h-[64px] absolute left-0"
          />
          <strong class="text-[24px]">支持定制需求服务</strong>
        </p>
        <p>
          <strong class="text-[16px] leading-7 text-[#7281a2] font-400">
            支持上门收款服务（线上贵宾厅白马会 / 玖鼎 / USDT 收款）；全球送现金/送黄金，
            泰国、迪拜、菲律宾、柬埔寨等国际化区域送现服务；客户足不出户，就可以安全完成交易，
            安全高效省心。
          </strong>
        </p>
      </ul>

      <ul class={`h-[280px] relative ${gradientLine}`}>
        <p class="flex items-center py-[20px] mb-[20px] justify-center relative">
          <img
            src="/assets/aboutus/06.png"
            alt="每日更新最优惠汇率"
            class="w-[64px] h-[64px] absolute left-0"
          />
          <strong class="text-[24px] pl-6">每日更新最优惠汇率</strong>
        </p>
        <p>
          <strong class="text-[16px] leading-7 text-[#7281a2] font-400">
            每日更新最优惠汇率至易换频道，客户可参考实时详细各类币种兑换汇率。
            易换客服7×24全天在线等您，随时为您提供贴心服务，感恩每一位客户的信任与支持！
          </strong>
        </p>
      </ul>
    </div>
  </section>

  <!-- PC 优势 -->
  <section
    class={`container lg:max-w-[1280px] mx-auto pt-[70px] ${pcOnly} gap-10 min-h-[308px] pb-[200px]`}
  >
    <h2 class="flex items-center justify-center py-[60px]">
      <span class="text-[#11254e] text-[40px] font-600">我们的优势</span>
    </h2>

    <div class="grid grid-cols-3 gap-4">
      <dl class="py-[60px] px-[40px] rounded-[40px] flex items-center border border-3 border-solid border-[#fff] bg-[rgba(255,255,255,0.7)]">
        <dt>
          <img src="/assets/aboutus/07.svg" alt="安全保证" class="w-[64px] h-[64px] mr-[30px]" />
        </dt>
        <dd>
          <h3><span class="text-[24px] font-600 text-[#11254e]">安全保证</span></h3>
          <h4 class="mt-[10px]">
            <span class="text-[16px] text-[#7281a2] leading-7">易换对于客户的所有<br />资料一律严格保密</span>
          </h4>
        </dd>
      </dl>

      <dl class="p-[30px] px-[40px] rounded-[40px] flex items-center border border-3 border-solid border-[#fff] bg-[rgba(255,255,255,0.7)]">
        <dt>
          <img src="/assets/aboutus/08.svg" alt="快速转账" class="w-[64px] h-[64px] mr-[30px]" />
        </dt>
        <dd>
          <h3><span class="text-[24px] font-600 text-[#11254e]">快速转账</span></h3>
          <h4 class="mt-[10px]">
            <span class="text-[16px] text-[#7281a2] leading-7">易换保证您的汇款在安全<br />的前提下快速到达</span>
          </h4>
        </dd>
      </dl>

      <dl class="p-[30px] px-[40px] rounded-[40px] flex items-center border border-3 border-solid border-[#fff] bg-[rgba(255,255,255,0.7)]">
        <dt>
          <img src="/assets/aboutus/09.svg" alt="资金安全" class="w-[64px] h-[64px] mr-[30px]" />
        </dt>
        <dd>
          <h3><span class="text-[24px] font-600 text-[#11254e]">资金安全</span></h3>
          <h4 class="mt-[10px]">
            <span class="text-[16px] text-[#7281a2] leading-7">易换提供最优惠的<br />最合适的私人定制换汇服务</span>
          </h4>
        </dd>
      </dl>
    </div>
  </section>

  <!-- H5 -->
  <div class={`${h5Only} bg-[#eef2fe] pb-20`}>
    <section class="mt-10 relative z-1">
      <h2>
        <img class="mx-auto h-20" src="/assets/aboutus/m/01.svg" alt="关于我们" />
      </h2>
    </section>

    <section class="-translate-y-25 relative z-0 h-55">
      <img src="/assets/aboutus/m/02.svg" alt="" />
    </section>

    <section class="pt-10 relative z-1">
      <h2 class="text-center pb-8">
        <span class="text-5 text-[#11254e]">新一代互联网银行</span>
      </h2>

      <h3 class="px-10">
        <span class="text-[#7281a2] text-xs leading-8">
          易换立足亚洲，享誉全球，从2018年成立起，秉承诚信经营为宗旨，以安全公正的服务为核心，
          持续扩展国际化路线，提供覆盖全球币种兑换服务，丰富多样的交易形式，持有最强竞争力的汇率，
          超低的手续费回馈给我们广大客户，我们以诚信、专业、高效、稳定的服务经营理念，致力于给全球客户最优质的换汇体验。
        </span>
      </h3>

      <img src="/assets/aboutus/m/03.svg" alt="" class="mx-auto" />
    </section>

    <section class="px-6">
      <ul class="h-68 relative after:content-[''] after:block after:w-[100%] after:h-1 after:rounded-20 after:absolute after:bottom-0 after:bg-[linear-gradient(90deg,_#3feae4_-13.67%,_#5383ff)]">
        <h2 class="flex items-center py-[20px] mb-[20px] justify-center relative">
          <img src="/assets/aboutus/04.svg" alt="覆盖全球多个国家" class="w-12 h-12 absolute left-0" />
          <span class="text-5 text-[#11254e]">覆盖全球多个国家</span>
        </h2>
        <h3>
          <span class="text-xs leading-8 text-[#7281a2] font-400">
            支持USDT、菲律宾PHP 、美国USD、香港HKD、迪拜AED、欧洲EUR、台湾TWD、泰国THB、越南VND等等，
            只要客户有换汇需求，易换都能给您服务到位，并不设最高和最低限额。所有客户的交易都可以享受我们最优质的服务。
          </span>
        </h3>
      </ul>

      <ul class="h-68 relative mt-4 after:content-[''] after:block after:w-[100%] after:h-1 after:rounded-20 after:absolute after:bottom-0 after:bg-[linear-gradient(90deg,_#3feae4_-13.67%,_#5383ff)]">
        <h2 class="flex items-center py-[20px] mb-[20px] justify-center relative">
          <img src="/assets/aboutus/05.svg" alt="支持定制需求服务" class="w-12 h-12 absolute left-0" />
          <span class="text-5 text-[#11254e]">支持定制需求服务</span>
        </h2>
        <h3>
          <span class="text-xs leading-8 text-[#7281a2] font-400">
            支持上门收款服务（线上贵宾厅白马会 / 玖鼎 / USDT 收款）；全球送现金/送黄金，
            泰国、迪拜、菲律宾、柬埔寨等国际化区域送现服务；客户足不出户，就可以安全完成交易，安全高效省心。
          </span>
        </h3>
      </ul>

      <ul class="pb-8 relative mt-4 after:content-[''] after:block after:w-[100%] after:h-1 after:rounded-20 after:absolute after:bottom-0 after:bg-[linear-gradient(90deg,_#3feae4_-13.67%,_#5383ff)]">
        <h2 class="flex items-center py-[20px] mb-[20px] justify-center relative">
          <img src="/assets/aboutus/06.png" alt="每日更新最优惠汇率" class="w-10 h-10 absolute left-0" />
          <span class="text-5 text-[#11254e]">每日更新最优惠汇率</span>
        </h2>
        <h3>
          <span class="text-xs leading-8 text-[#7281a2] font-400">
            每日更新最优惠汇率至易换频道，客户可参考实时详细各类币种兑换汇率。
            易换客服7×24全天在线等您，随时为您提供贴心服务，感恩每一位客户的信任与支持！
          </span>
        </h3>
      </ul>
    </section>

    <section class="pt-10 mx-6">
      <h2 class="text-center pb-8">
        <span class="text-5 text-[#11254e]">我们的优势</span>
      </h2>

      <ul class="p-8 flex items-center rounded-[20px] border border-3 border-solid border-[#fff] bg-[rgba(255,255,255,0.7)]">
        <img src="/assets/home/09.svg" alt="" class="w-16 h-16 mx-auto" />
        <div class="flex-1 pl-6">
          <h3><span class="text-4 font-600 text-[#11254e]">安全保证</span></h3>
          <h4 class="text-xs text-[#7281a2] py-4">易换对于客户的所有</h4>
          <h4 class="text-xs text-[#7281a2]">资料一律严格保密</h4>
        </div>
      </ul>

      <ul class="p-8 mt-4 flex items-center rounded-[20px] border border-3 border-solid border-[#fff] bg-[rgba(255,255,255,0.7)]">
        <img src="/assets/home/10.svg" alt="" class="w-16 h-16 mx-auto" />
        <div class="flex-1 pl-6">
          <h3><span class="text-4 font-600 text-[#11254e]">快速转账</span></h3>
          <h4 class="text-xs text-[#7281a2] py-4">易换保证您的汇款在安全</h4>
          <h4 class="text-xs text-[#7281a2]">的前提下快速到达</h4>
        </div>
      </ul>

      <ul class="p-8 mt-4 flex items-center rounded-[20px] border border-3 border-solid border-[#fff] bg-[rgba(255,255,255,0.7)]">
        <img src="/assets/home/11.svg" alt="" class="w-16 h-16 mx-auto" />
        <div class="flex-1 pl-6">
          <h3><span class="text-4 font-600 text-[#11254e]">优惠汇率</span></h3>
          <h4 class="text-xs text-[#7281a2] py-4">易换提供最优惠的</h4>
          <h4 class="text-xs text-[#7281a2]">最合适的私人定制换汇服务</h4>
        </div>
      </ul>
    </section>
  </div>
</BaseLayout>
