---
import { getAbsoluteLocaleUrlList } from "astro:i18n";
import { t, resolveLocale, type Locale } from "@/lib/i18n";
const locale: Locale = resolveLocale(Astro.currentLocale);
const {
  title = t(locale, "易换 | 在线换汇专家 - USDT/东南亚多币种极速安全兑换"),
  keyword = t(
    locale,
    "在线换汇,货币兑换,外币汇率,东南亚换汇,马尼拉换汇,曼谷换汇,最佳外汇交易应用,免费换汇用什么APP,怎样减少换汇手续费",
  ),
  description = t(
    locale,
    "【易换】全球货币兑换与跨境支付平台，重点服务东南亚市场。支持菲律宾比索、泰铢、越南盾、马来西亚、柬埔寨等主流币种安全极速兑换。全网极低费率，即时到账。立即下载APP！",
  ),
  image = "/favicon.png",
  lang = Astro.currentLocale,
} = Astro.props;
const alternates = getAbsoluteLocaleUrlList(Astro.url.pathname);
---

<!-- Global SEO Head -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="keyword" content={keyword} />
<meta name="description" content={description} />
<link rel="icon" href="/favicon.png" type="image/png+xml" />
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

{
  alternates.map((item: any) => (
    <link
      rel="alternate"
      hreflang={item.locale === Astro.currentLocale ? "x-default" : item.lang}
      href={item.url}
    />
  ))
}

<!-- Open Graph / Twitter -->
<meta property="og:type" content="website" />
<meta
  property="og:url"
  content={new URL(Astro.url.pathname, Astro.site).toString()}
/>
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<!-- UnoCSS reset is injected via integration -->
