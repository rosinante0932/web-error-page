{
  "name": "astro-vue-project",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "cross-env APP_ENV=dev astro dev",
    "test": "cross-env APP_ENV=test astro dev",
    "rc": "cross-env APP_ENV=rc astro dev",
    "prod": "cross-env APP_ENV=prod astro dev",
    "build:dev": "cross-env APP_ENV=dev astro build",
    "build:test": "cross-env APP_ENV=test NODE_OPTIONS='--max-old-space-size=2048' astro build",
    "build:rc": "cross-env APP_ENV=rc astro build",
    "build:prod": "cross-env APP_ENV=prod astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "a:test": "npx autocannon http://127.0.0.1:4321/zh -c 1000 -d 60",
    "start": "cross-env NODE_OPTIONS='--max-old-space-size=512 --expose-gc' pm2-runtime start ecosystem.config.cjs"
  },
  "dependencies": {
    "@astrojs/node": "8.3.4",
    "@astrojs/sitemap": "3.2.1",
    "@astrojs/vue": "4.5.0",
    "astro": "4.16.19",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@types/vue": "^2.0.0",
    "@unocss/astro": "^66.5.12",
    "@unocss/reset": "^66.5.12",
    "cross-env": "^10.1.0",
    "pm2": "^6.0.14",
    "tailwind.css": "link:@unocss/reset/tailwind.css",
    "unocss": "^66.5.12"
  }
}